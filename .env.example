# Copy this file to .env and fill in your values
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.0-flash / gemini-2.5-flash are no longer available to new API keys
# as of late 2026 — gemini-3.8-flash is the current equivalent.
VICTIM_MODEL=gemini-3.8-flash
RED_AGENT_MODEL=gemini-3.8-flash
BLUE_AGENT_MODEL=gemini-3.8-flash
# 1, not 3: with MAX_TOTAL_ATTACKS capped for demo speed (see red_agent.py),
# a higher per-category count means the Red Agent exhausts its whole budget
# retrying the profiler's first-ranked hypothesis instead of ever trying
# hypothesis #2 or #3 — 1 spreads the budget across more distinct attempts.
MAX_ATTACKS_PER_CATEGORY=1
MAX_MUTATION_ATTEMPTS=1
REQUEST_DELAY_MS=500
FRONTEND_URL=http://localhost:5173
